# ── Auth ──────────────────────────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-strong-random-secret-in-production

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./ai_log_analyzer.db
# For PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/ai_log_analyzer

# ── Elasticsearch ─────────────────────────────────────────────────────────────
ES_HOST=http://localhost:9200
ES_USERNAME=
ES_PASSWORD=
ES_API_KEY=
ES_INDEX=logs-*
ES_TIMEOUT=5

# ── Kafka ─────────────────────────────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092
KAFKA_CONSUMER_GROUP=log-consumers
KAFKA_TOPICS=logs-raw,logs-processed,logs-alerts
KAFKA_TIMEOUT=5

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TIMEOUT=3

# ── Groq AI ───────────────────────────────────────────────────────────────────
# Get a FREE key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
